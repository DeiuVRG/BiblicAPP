# Environment of the Ask gateway (apps/api). Copy to apps/api/.env and export it, or pass the
# values on the command line; nothing here is required to run in mock mode:
#
#   AI_PROVIDER=mock pnpm --filter @biblioteca/api dev
#
# Secrets (ANTHROPIC_API_KEY) never go in this repository: set them in the environment of the
# process, and as a Fly secret in production (fly secrets set ANTHROPIC_API_KEY=...).

# --- Server ---------------------------------------------------------------------------------
# Port and interface to listen on. Default 8787 / 0.0.0.0.
PORT=8787
LISTEN_HOST=0.0.0.0
# development | test | production
NODE_ENV=development
# debug | info | warn | error | silent. Question text is never logged, at any level.
LOG_LEVEL=info
# Salt for the hashes that stand in for question text and client addresses in logs. Random per
# process when unset (hashes then differ between restarts).
# LOG_HASH_SALT=

# --- Model provider -------------------------------------------------------------------------
# mock: deterministic answers that quote and cite the first two sources, no key needed.
# claude: the Anthropic API (needs ANTHROPIC_API_KEY).
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=
# Only for a proxy or a stand-in server (tests); leave unset for api.anthropic.com.
# ANTHROPIC_BASE_URL=
MODEL=claude-sonnet-5-5
# Maximum tokens of one answer (thinking counts towards it).
MAX_OUTPUT_TOKENS=1200
# output_config.effort: low | medium | high | xhigh | max | none (none leaves it out, for models
# that do not take it).
MODEL_EFFORT=low
# default: ask the API for its server-side refusal fallback (beta header server-side-fallback-2026-07-01).
MODEL_FALLBACK=off
# Wait for the model's response headers, and automatic retries (429, 5xx, network).
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=2
# Overall limit of one answer, in milliseconds.
ASK_DEADLINE_MS=120000

# --- Content --------------------------------------------------------------------------------
# Folders of signed packs (one folder per edition: manifest.json + pack.json) and of the pinned
# public keys (*.pub). The defaults point into the repository checkout:
#   PACKS_DIR=<repo>/apps/mobile/assets/packs   KEYS_DIR=<repo>/content/keys
# The Docker image sets /app/packs and /app/keys.
# PACKS_DIR=
# KEYS_DIR=

# --- Web access -----------------------------------------------------------------------------
# Comma-separated list of origins allowed by CORS (scheme://host[:port], no wildcard).
ALLOWED_ORIGINS=https://deiuvrg.github.io,http://localhost:8081,http://127.0.0.1:8081
# none: use the socket address (the default, and what the Docker image uses). fly: trust the
# Fly-Client-IP header (only behind the Fly.io proxy: fly.toml sets it). xff: the last
# X-Forwarded-For entry. A header that is not an IP address is ignored in both of the last two.
TRUST_PROXY=none
# Largest request body, in bytes.
MAX_BODY_BYTES=65536
# Time a client gets to send a whole request, and its headers, in milliseconds. A slower sender
# is cut off with 408, so half-sent questions cannot hold the machine's request slots.
REQUEST_TIMEOUT_MS=15000
HEADERS_TIMEOUT_MS=10000

# --- Closed beta and cost brakes ----------------------------------------------------------------
# Tester access code(s): one code, or several separated by commas (1 to 128 visible ASCII
# characters each, no spaces). Set, POST /v1/ask needs the header X-Access-Code with one of them,
# otherwise it answers 401 access_required, before the rate limit and before any model call.
# Unset: an open beta (an empty value counts as unset too, and start-up warns about it with
# `access.open`). It is a secret: on Fly `fly secrets set ACCESS_CODE=...`, never in a file in the
# repository. Use a long random value (for example `openssl rand -base64 18`): wrong codes are
# throttled per client address (below), but a short code is still the one a guesser finds.
# ACCESS_CODE=
# Wrong codes one client address may present per window before it is refused with 429 (before its
# code is even looked at) until the allowance refills: a token bucket, so 20 per 600 s is a burst
# of 20, then one more attempt every 30 seconds. A missing code costs nothing. Raise it if many
# testers share one address (a classroom behind one router), lower it to be stricter.
ACCESS_FAILURE_MAX=20
ACCESS_FAILURE_WINDOW_SECONDS=600
# Questions answered per UTC day, all clients together (0 = off). Above it POST /v1/ask answers
# 503 provider_busy with Retry-After until midnight UTC. The count is in memory: it belongs to
# one machine and starts from zero when the process restarts.
DAILY_QUESTION_CAP=0

# --- Rate limits (per client address, token bucket) -------------------------------------------
# Questions: RATE_LIMIT_MAX per RATE_LIMIT_WINDOW_SECONDS (default 20 per 10 minutes).
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=600
# Health, library and root: RATE_LIMIT_READ_MAX per RATE_LIMIT_READ_WINDOW_SECONDS.
RATE_LIMIT_READ_MAX=120
RATE_LIMIT_READ_WINDOW_SECONDS=60

# --- Shutdown -------------------------------------------------------------------------------
# On SIGTERM, running answers get this long to finish before they are cut off.
SHUTDOWN_GRACE_MS=20000
