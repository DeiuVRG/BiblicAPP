{
  "name": "@biblioteca/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ask gateway of the library: retrieval over the signed packs and answers with citations (Hono on Node).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "eval": "tsx src/eval/run-eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.0.0",
    "@biblioteca/content-tools": "workspace:*",
    "@biblioteca/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
