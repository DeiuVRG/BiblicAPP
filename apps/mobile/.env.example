# Public values only. Anything prefixed EXPO_PUBLIC_ is embedded in the client bundle.
# Base path when exporting for GitHub Pages (project site):
# EXPO_PUBLIC_WEB_BASE_URL=/BiblicAPP
# Where the feedback and report mail links of the interface go (a public value: it is on the page).
# Without it they open a new message with no recipient (docs/ui-spec-v2.md, OQ-10).
# EXPO_PUBLIC_FEEDBACK_EMAIL=
# A build with the flags of Beta 1 already on (ask, bookmarks, about, transparency): the five items
# of the section bar, the two doors and the transparency band. For the browser checks of
# docs/ui-spec-v2.md 20 (S1, S2, L2, L3, L7), never for a delivered build.
# EXPO_PUBLIC_FEATURES=beta1
