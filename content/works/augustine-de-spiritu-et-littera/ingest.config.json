  "replacements": [
    {
      "pattern": "\\bjusti cabitur\\b",
      "flags": "g",
      "replace": "justificabitur",
      "note": "OCR: the 'fi' of 'justificabitur' is lost and the word split (chapter IX)"
    },
    {
      "pattern": "\\bverum etiam\\. adjutorem\\b",
      "flags": "g",
      "replace": "verum etiam adjutorem",
      "note": "stray full stop before the margin of the line (chapter II, section 3)"
    },
    {
      "pattern": "\\bnos divinitus\\. adjuvari\\b",
      "flags": "g",
      "replace": "nos divinitus adjuvari",
      "note": "stray full stop at the end of a line (chapter XII, section 20)"
    },
    {
      "pattern": "ė",
      "flags": "g",
      "replace": "e",
      "note": "OCR: 'e' with a dot ('prodėrunt', chapter XXVIII)"
    },
    {
      "pattern": "\\bcerimoniae\\b",
      "flags": "g",
      "replace": "caerimoniae",
      "note": "OCR 'ceri-moniae' (chapter XXI, section 36); Augustine quotes the phrase as 'caerimoniae' in Retractationes ii. 37, printed on page 98 of the same volume, and the margin of the line refers to it ('See below, p. 98')"
    },
    {
      "pattern": "\\s+([;:?!])",
      "flags": "g",
      "replace": "$1",
      "note": "the print sets a space before ; : ? !, Latin text has none"
    }
  ],
